# Google Gemini API Key (for System 2 Gemma 4 reasoning)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Security and Routing Thresholds
SECURITY_QUARANTINE_THRESHOLD=0.35
CLUTTER_FILTER_THRESHOLD=0.55

# Storage Paths
VAULT_DIR=./vault
DB_PATH=./chronicle_vault.db
DEMO_SAMPLES_DIR=./demo_samples
